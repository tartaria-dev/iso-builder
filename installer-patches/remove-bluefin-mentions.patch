             "label": friendly,
@@ -109,6 +114,8 @@ def apply_progress_event(line: str, state: dict) -> dict | None:
         label = None
         if state["current_step"]:
             friendly = _FRIENDLY_STEP_LABELS.get(state["current_step_name"], state["current_step_name"])
+            if "{distro}" in friendly:
+                friendly = friendly.format(distro=distro_name)
             label = friendly
         return {"fraction": fraction, "label": label, "pulse": False, "complete": False}
 
