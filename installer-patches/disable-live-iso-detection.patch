diff --git a/bootc_installer/utils/recipe.py b/bootc_installer/utils/recipe.py
index 9787bd5b..63236a5f 100644
--- a/bootc_installer/utils/recipe.py
+++ b/bootc_installer/utils/recipe.py
@@ -78,6 +78,13 @@ class RecipeLoader:
 
     def __enrich(self):
         """Post-load enrichment: detect live ISO mode and inject local bootc image."""
+        # A recipe can explicitly opt out of live ISO auto-detection, e.g. for
+        # distros that ship a multi-image picker even when booted from a live
+        # squashfs/ostree medium. This always wins over auto-detection, but
+        # NOT over the explicit force-on flag file below (that flag is meant
+        # for live ISO builders and takes precedence by design).
+        detection_disabled = bool(self.__recipe.get("disable_live_iso_detection"))
+
         is_ostree_booted = os.path.exists("/run/ostree-booted")
         # Also detect squashfs-based live ISOs (dracut dmsquash-live) which do not
         # set /run/ostree-booted because they are not ostree deployments.
@@ -87,7 +94,15 @@ class RecipeLoader:
         # the installer runs inside a Flatpak sandbox (where /.flatpak-info exists and
         # /run/initramfs/live or /run/ostree-booted may be inaccessible).
         is_live_flagged = os.path.exists(f"{self._etc}/bootc-installer/live-iso-mode")
-        live_iso_mode = is_live_flagged or (not self._in_flatpak and (is_ostree_booted or is_live_squashfs))
+        live_iso_mode = is_live_flagged or (
+            not detection_disabled and not self._in_flatpak and (is_ostree_booted or is_live_squashfs)
+        )
+
+        if detection_disabled and not is_live_flagged:
+            logger.info(
+                "disable_live_iso_detection set in recipe: skipping ostree/squashfs "
+                "auto-detection (image selection step, if configured, stays enabled)"
+            )
 
         if live_iso_mode:
             # local_imgref is an optional override for the install *source* used only
