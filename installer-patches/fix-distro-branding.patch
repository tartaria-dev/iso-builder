--- a/bootc_installer/defaults/welcome.py
+++ b/bootc_installer/defaults/welcome.py
@@ -95,6 +95,17 @@ class BootcDefaultWelcome(Adw.Bin):
         if welcome_subtitle:
             self.page_header.subtitle = welcome_subtitle
 
+        # The install button defaults to a hardcoded "Install Bluefin" in
+        # the template. Override it from the recipe's distro_name so other
+        # distros don't ship Bluefin-branded button text. An explicit
+        # install_button_title always wins if the recipe sets one.
+        distro_name = self.__distro_info.get("distro_name", "")
+        install_title = self.__distro_info.get("install_button_title") or (
+            f"Install {distro_name}" if distro_name else None
+        )
+        if install_title:
+            self.row_install.set_title(install_title)
+
         try:
             self.row_bluetooth.set_visible(_needs_bluetooth_pairing())
         except Exception:
