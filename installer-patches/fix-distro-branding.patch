-def apply_progress_event(line: str, state: dict) -> dict | None:
+def apply_progress_event(line: str, state: dict, distro_name: str = "Bluefin") -> dict | None:
     """Parse one fisherman log line and return a UI-update dict, or None.
 
     Pure function — no GTK, no I/O.  The returned dict has:
@@ -53,6 +53,7 @@ def apply_progress_event(line: str, state: dict) -> dict | None:
       "pulse"     — bool; True means switch bar to pulse mode
       "complete"  — bool; True means install finished
     ``state`` is mutated in-place to track multi-line context.
+    ``distro_name`` fills the "{distro}" placeholder in friendly labels.
     Returns None for non-JSON lines or events that require no UI change.
     """
     if not line.startswith("{"):
@@ -79,6 +82,8 @@ def apply_progress_event(line: str, state: dict) -> dict | None:
         state["seen_substeps"].clear()
         state["pulse_active"] = False
         friendly = _FRIENDLY_STEP_LABELS.get(name, name)
+        if "{distro}" in friendly:
+            friendly = friendly.format(distro=distro_name)
         return {
             "fraction": cumulative_pct / 100.0,
             "label": friendly,
@@ -109,6 +114,8 @@ def apply_progress_event(line: str, state: dict) -> dict | None:
         label = None
         if state["current_step"]:
             friendly = _FRIENDLY_STEP_LABELS.get(state["current_step_name"], state["current_step_name"])
+            if "{distro}" in friendly:
+                friendly = friendly.format(distro=distro_name)
             label = friendly
         return {"fraction": fraction, "label": label, "pulse": False, "complete": False}
 
