+// allowRegistryPull forces the host-filesystem live-ISO probe off so CheckImage
+// tests exercise the registry/local logic regardless of the runner's own /var
+// filesystem type (which may be overlayfs/tmpfs in CI containers).
+// stubHostVarTmpBind replaces the real host /var/tmp binder with a no-op so
+// install-path tests never issue mount/umount against the test host.
+func stubHostVarTmpBind(t *testing.T) *string {
+	t.Helper()
+	scratch := ""
+	install.HostVarTmpBindFn = func(s string) func() {
+		scratch = s
+		return func() {}
+	}
+	t.Cleanup(func() { install.HostVarTmpBindFn = install.DefaultHostVarTmpBind })
+	return &scratch
+}
+
+func allowRegistryPull(t *testing.T) {
+	t.Helper()
+	install.HostVarConstrainedFn = func() bool { return false }
+	t.Cleanup(func() { install.HostVarConstrainedFn = install.DefaultHostVarConstrained })
+}
