+// TestBootcInstall_NonComposefsContainer_LiveHostSkipsPull verifies that the
+// redirected-storage container path does not force a registry re-pull on a
+// live ISO (HostVarConstrainedFn true), and still does on a regular host.
+func TestBootcInstall_NonComposefsContainer_LiveHostSkipsPull(t *testing.T) {
+	run := func(t *testing.T, constrained bool) string {
+		controlledAncillaryMountCommands(t)
+		defer install.SetStorageSpaceConstrainedForTest(true)()
+		defer install.SetSelectStorageDriverForTest("overlay", "forced for test")()
+		defer install.SetHostHasBootcForTest(false)()
+		_ = stubHostVarTmpBind(t)
+
+		install.HostVarConstrainedFn = func() bool { return constrained }
+		t.Cleanup(func() { install.HostVarConstrainedFn = install.DefaultHostVarConstrained })
+
+		dir := t.TempDir()
+		log := dir + "/podman.log"
+		podman := dir + "/podman"
+		script := "#!/bin/sh\necho \"$@\" >> " + log + "\nexit 0\n"
+		if err := os.WriteFile(podman, []byte(script), 0755); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv("PATH", dir+":"+os.Getenv("PATH"))
+
+		install.SkopeoExportOCIFn = func(image, destDir, tmpdir string) error {
+			if err := os.MkdirAll(destDir, 0755); err != nil {
+				return err
+			}
+			return os.WriteFile(destDir+"/index.json", []byte("{}"), 0644)
+		}
+		t.Cleanup(func() { install.SkopeoExportOCIFn = install.DefaultSkopeoExportOCI })
+
+		_ = install.BootcInstall(install.Options{
+			SourceImgref: "docker://ghcr.io/ublue-os/bluefin:stable",
+			TargetImgref: "ghcr.io/ublue-os/bluefin:stable",
+			Target:       dir + "/target",
+			ScratchDir:   dir + "/scratch",
+		})
+		b, _ := os.ReadFile(log)
+		return string(b)
+	}
+
+	hasPull := func(log string) bool {
+		for _, l := range strings.Split(log, "\n") {
+			if strings.Contains(l, " pull ") || strings.HasPrefix(l, "pull ") {
+				return true
+			}
+		}
+		return false
+	}
+
+	t.Run("live host does not pull", func(t *testing.T) {
+		if log := run(t, true); hasPull(log) {
+			t.Errorf("podman pull ran on a live host:\n%s", log)
+		}
+	})
+	t.Run("regular host still pulls", func(t *testing.T) {
+		if log := run(t, false); !hasPull(log) {
+			t.Errorf("expected a podman pull on a regular host (control), got:\n%s", log)
+		}
+	})
+}
