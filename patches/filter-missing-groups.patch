+// TestFilterExistingGroups_UnreadableGroupFile verifies that when the target's
+// /etc/group can't be read at all, filtering is skipped (groups pass through
+// unchanged) rather than treating every group as missing.
+func TestFilterExistingGroups_UnreadableGroupFile(t *testing.T) {
+	root := t.TempDir() // no etc/group present
+	kept, missing := filterExistingGroups(root, []string{"wheel", "libvirt"})
+	if len(missing) != 0 {
+		t.Errorf("missing = %v, want none (unreadable group file should not fabricate missing groups)", missing)
+	}
+	if strings.Join(kept, ",") != "wheel,libvirt" {
+		t.Errorf("kept = %v, want groups to pass through unchanged", kept)
+	}
+}
+
+func TestFilterExistingGroups_NoGroupsRequested(t *testing.T) {
+	root := t.TempDir()
+	kept, missing := filterExistingGroups(root, nil)
+	if kept != nil || missing != nil {
+		t.Errorf("expected (nil, nil) for no requested groups, got (%v, %v)", kept, missing)
+	}
+}
