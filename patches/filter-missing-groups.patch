+// TestCreateUserSkipsMissingGroups is the regression test for the useradd
+// exit-6 crash: a recipe-supplied group (e.g. "libvirt") that isn't present in
+// the target's own /etc/group — because the image doesn't ship the package
+// that creates it — must be dropped with a warning rather than passed to
+// useradd, where it aborts account creation (and, via CreateUser's fatal
+// caller, the whole install) over one optional group.
+func TestCreateUserSkipsMissingGroups(t *testing.T) {
+	sysroot := t.TempDir()
+	deployDir := filepath.Join(sysroot, "ostree", "deploy", "default", "deploy", "abc123.0")
+	if err := os.MkdirAll(filepath.Join(deployDir, "etc"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	// The target's own /etc/group: has "wheel" and "video", but no "libvirt"
+	// or "docker" (image doesn't ship those packages).
+	groupFile := "root:x:0:\nwheel:x:10:\nvideo:x:39:\n"
+	if err := os.WriteFile(filepath.Join(deployDir, "etc", "group"), []byte(groupFile), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	origDeployFn := DeploymentDirFn
+	defer func() { DeploymentDirFn = origDeployFn }()
+	DeploymentDirFn = func(string) (string, error) { return deployDir, nil }
+
+	var calls [][]string
+	origRunFn := runner.RunFn
+	defer func() { runner.RunFn = origRunFn }()
+	runner.RunFn = func(_ io.Reader, name string, args ...string) error {
+		calls = append(calls, append([]string{name}, args...))
+		if name == "ls" {
+			_, err := os.Stat(args[len(args)-1])
+			return err
+		}
+		return nil
+	}
+
+	err := CreateUser(sysroot, UserConfig{
+		Username: "dave",
+		Groups:   []string{"wheel", "libvirt", "video", "docker"},
+	})
+	if err != nil {
+		t.Fatalf("CreateUser: %v", err)
+	}
+
+	var groupsArg string
+	for _, c := range calls {
+		if c[0] == "chroot" && len(c) > 2 && c[2] == "useradd" {
+			for i, a := range c {
+				if a == "--groups" && i+1 < len(c) {
+					groupsArg = c[i+1]
+				}
+			}
+		}
+	}
+	if groupsArg == "" {
+		t.Fatalf("useradd was not called with --groups; calls: %v", calls)
+	}
+	if strings.Contains(groupsArg, "libvirt") || strings.Contains(groupsArg, "docker") {
+		t.Errorf("--groups %q still contains a group missing from the target's /etc/group", groupsArg)
+	}
+	if !strings.Contains(groupsArg, "wheel") || !strings.Contains(groupsArg, "video") {
+		t.Errorf("--groups %q dropped a group that DOES exist on the target", groupsArg)
+	}
+}
