+func TestCreateUserAllGroupsMissingOmitsFlag(t *testing.T) {
+	sysroot := t.TempDir()
+	deployDir := filepath.Join(sysroot, "ostree", "deploy", "default", "deploy", "abc123.0")
+	if err := os.MkdirAll(filepath.Join(deployDir, "etc"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(deployDir, "etc", "group"), []byte("root:x:0:\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	origDeployFn := DeploymentDirFn
+	defer func() { DeploymentDirFn = origDeployFn }()
+	DeploymentDirFn = func(string) (string, error) { return deployDir, nil }
+
+	var calls [][]string
+	origRunFn := runner.RunFn
+	defer func() { runner.RunFn = origRunFn }()
+	runner.RunFn = func(_ io.Reader, name string, args ...string) error {
+		calls = append(calls, append([]string{name}, args...))
+		if name == "ls" {
+			_, err := os.Stat(args[len(args)-1])
+			return err
+		}
+		return nil
+	}
+
+	if err := CreateUser(sysroot, UserConfig{Username: "erin", Groups: []string{"libvirt"}}); err != nil {
+		t.Fatalf("CreateUser: %v", err)
+	}
+	for _, c := range calls {
+		if c[0] == "chroot" && len(c) > 2 && c[2] == "useradd" {
+			for _, a := range c {
+				if a == "--groups" {
+					t.Errorf("--groups should be omitted when no groups exist on the target; calls: %v", calls)
+				}
+			}
+		}
+	}
+}
