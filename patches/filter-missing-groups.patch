+// filterExistingGroups reads root/etc/group (the TARGET's own group database,
+// not the host's) and splits groups into those present there and those that
+// aren't. Called with the same root CreateUser is about to hand to useradd, so
+// the check reflects exactly what useradd itself would see.
+//
+// If root/etc/group can't be read, filtering is skipped entirely (groups is
+// returned unchanged, missing is nil) rather than silently dropping every
+// group: an unreadable file means the check itself is unreliable, and
+// useradd's own error is a clearer signal than a fabricated "all groups
+// missing" warning.
+func filterExistingGroups(root string, groups []string) (kept, missing []string) {
+	if len(groups) == 0 {
+		return nil, nil
+	}
+	data, err := os.ReadFile(filepath.Join(root, "etc", "group"))
+	if err != nil {
+		return groups, nil
+	}
+	existing := make(map[string]bool, strings.Count(string(data), "\n"))
+	for _, line := range strings.Split(string(data), "\n") {
+		name, _, ok := strings.Cut(line, ":")
+		if ok && name != "" {
+			existing[name] = true
+		}
+	}
+	for _, g := range groups {
+		if existing[g] {
+			kept = append(kept, g)
+		} else {
+			missing = append(missing, g)
+		}
+	}
+	return kept, missing
+}
