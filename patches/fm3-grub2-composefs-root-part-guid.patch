+// TestPartitionGrub2Composefs_SfdiskScript verifies the grub2+composefs layout
+// is the same 3-partition layout as Partition but with the root typed as the
+// DPS root, so sealed (no root=) images are discoverable by gpt-auto-generator.
+// Partition itself must keep the generic linux type for ostree installs.
+func TestPartitionGrub2Composefs_SfdiskScript(t *testing.T) {
+	recPlain := setupRecorder(t)
+	if err := disk.Partition("/dev/sda"); err != nil {
+		t.Fatalf("Partition: %v", err)
+	}
+	plain := sfdiskStdin(t, recPlain)
+
+	rec := setupRecorder(t)
+	if err := disk.PartitionGrub2Composefs("/dev/sda"); err != nil {
+		t.Fatalf("PartitionGrub2Composefs: %v", err)
+	}
+	script := sfdiskStdin(t, rec)
+
+	var lines, plainLines []string
+	for _, l := range strings.Split(script, "\n") {
+		if l = strings.TrimSpace(l); l != "" && !strings.HasPrefix(l, "label:") {
+			lines = append(lines, l)
+		}
+	}
+	for _, l := range strings.Split(plain, "\n") {
+		if l = strings.TrimSpace(l); l != "" && !strings.HasPrefix(l, "label:") {
+			plainLines = append(plainLines, l)
+		}
+	}
+	if len(lines) != 3 {
+		t.Fatalf("expected 3 partition lines, got %d:\n%s", len(lines), script)
+	}
+	// EFI and /boot are unchanged from Partition.
+	if lines[0] != plainLines[0] || lines[1] != plainLines[1] {
+		t.Errorf("EFI//boot lines differ from Partition:\ncomposefs: %q\nplain:     %q", lines[:2], plainLines[:2])
+	}
+	if !strings.Contains(lines[2], "type="+disk.LinuxRootPartType()) {
+		t.Errorf("root (p3) missing type=%s: %q", disk.LinuxRootPartType(), lines[2])
+	}
+	if strings.Contains(lines[2], "size=") {
+		t.Errorf("root should fill remaining space (no size=): %q", lines[2])
+	}
+	// Partition must stay generic-linux for non-composefs grub2 installs.
+	if !strings.Contains(plainLines[2], "type=linux,") {
+		t.Errorf("Partition root should keep type=linux, got %q", plainLines[2])
+	}
+}
