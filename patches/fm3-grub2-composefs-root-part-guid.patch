 func Partition(disk string) error {
-	script := strings.Join([]string{
+	return partition(disk, grub2Script("linux"))
+}
+
+// grub2Script is the three-partition sfdisk script shared by Partition and
+// PartitionGrub2Composefs; rootType is the sfdisk type for the root partition.
+func grub2Script(rootType string) string {
+	return strings.Join([]string{
 		"label: gpt",
 		"",
 		`size=2GiB, type=uefi, name="EFI-SYSTEM"`,
 		`size=2GiB,   type=linux, name="boot"`,
-		`type=linux, name="root"`,
+		fmt.Sprintf(`type=%s, name="root"`, rootType),
 	}, "\n") + "\n"
-	return partition(disk, script)
+}
+
+// PartitionGrub2Composefs wipes disk and creates the same three-partition
+// layout as Partition, but with the root (p3) carrying the architecture's DPS
+// root type from the start.
+//
+// Sealed composefs images boot without a static root= argument (the disk is
+// partitioned at install time, so no UUID is known at image-build time), so
+// grub2 needs GPT auto-discovery just as much as systemd-boot does (#219) —
+// plain or LUKS-wrapped, since the initrd locates the LUKS container itself by
+// this type. Setting it here rather than retagging after the install also
+// covers the encrypted case, where the raw partition is hidden behind the LUKS
+// mapping. Ostree (non-composefs) grub2 installs keep the generic "linux" type
+// via Partition: they carry an explicit root=UUID and need no discovery.
+func PartitionGrub2Composefs(disk string) error {
+	return partition(disk, grub2Script(LinuxRootPartType()))
 }
 
