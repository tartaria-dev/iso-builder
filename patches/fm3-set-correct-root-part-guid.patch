+
+// TestGptRootRetagPartition covers the regression for the composefs-native
+// boot hang: systemd-gpt-auto-generator has no static root= to fall back on
+// for a "sealed" install, and previously only the unencrypted systemd-boot
+// case was retagged to the Discoverable Partitions Specification root GUID —
+// grub2 and LUKS-encrypted composefs installs silently kept the generic
+// "linux" GPT type and hung on first boot.
+func TestGptRootRetagPartition(t *testing.T) {
+	tests := []struct {
+		name             string
+		isManual         bool
+		isSystemdBoot    bool
+		filesystem       string
+		composeFsBackend bool
+		wantPartNum      int
+		wantOK           bool
+	}{
+		{
+			name:          "systemd-boot composefs unencrypted: partition 2 (regression baseline)",
+			isSystemdBoot: true, composeFsBackend: true,
+			wantPartNum: 2, wantOK: true,
+		},
+		{
+			name:          "grub2 composefs: partition 3, not skipped",
+			isSystemdBoot: false, composeFsBackend: true,
+			wantPartNum: 3, wantOK: true,
+		},
+		{
+			name: "systemd-boot composefs must retag even though bootc caller no longer excludes LUKS: partition 2",
+			// (encryption itself isn't a parameter here — this function no
+			// longer takes hasEncryption at all, which is the fix: the retag
+			// decision must not depend on it.)
+			isSystemdBoot: true, composeFsBackend: true,
+			wantPartNum: 2, wantOK: true,
+		},
+		{
+			name:          "zfs composefs: never retagged (own pool-based root discovery)",
+			isSystemdBoot: true, filesystem: "zfs", composeFsBackend: true,
+			wantPartNum: 0, wantOK: false,
+		},
+		{
+			name:     "manual layout composefs: never retagged (not fisherman's partition to guess)",
+			isManual: true, isSystemdBoot: true, composeFsBackend: true,
+			wantPartNum: 0, wantOK: false,
+		},
+		{
+			name:          "non-composefs: never retagged (has a real UUID-based root=)",
+			isSystemdBoot: true, composeFsBackend: false,
+			wantPartNum: 0, wantOK: false,
+		},
+		{
+			name:          "grub2 non-composefs: never retagged",
+			isSystemdBoot: false, composeFsBackend: false,
+			wantPartNum: 0, wantOK: false,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotPartNum, gotOK := gptRootRetagPartition(tt.isManual, tt.isSystemdBoot, tt.filesystem, tt.composeFsBackend)
+			if gotOK != tt.wantOK {
+				t.Fatalf("ok = %v, want %v", gotOK, tt.wantOK)
+			}
+			if gotOK && gotPartNum != tt.wantPartNum {
+				t.Errorf("partNum = %d, want %d", gotPartNum, tt.wantPartNum)
+			}
+		})
+	}
+}
diff --git a/fisherman/internal/disk/partition.go b/fisherman/internal/disk/partition.go
index 91a40be..cbf83ac 100644
--- a/fisherman/internal/disk/partition.go
+++ b/fisherman/internal/disk/partition.go
@@ -18,7 +18,30 @@ import (
 // procMountsPath is the path to the mounts file. Overridden in tests.
 var procMountsPath = "/proc/mounts"
 
-const GPTPartTypeLinuxRootX86_64 = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
+// Discoverable Partitions Specification "Linux root" type GUIDs. The generic
+// "linux" shorthand sfdisk writes (0fc63daf-8483-4772-8e79-3d69d8477de4,
+// filesystem type "Linux filesystem data") is NOT one of these — it tells
+// systemd-gpt-auto-generator nothing about which partition is root, on any
+// architecture, encrypted or not. Composefs-native/sealed images boot without
+// a static root= kernel argument (the disk is partitioned at install time, so
+// no UUID is known at image-build time) and rely entirely on
+// systemd-gpt-auto-generator finding a partition tagged with one of these
+// GUIDs.
+const (
+	GPTPartTypeLinuxRootX86_64 = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
+	GPTPartTypeLinuxRootARM64  = "b921b045-1df0-41c3-af44-4c6f280d3fae"
+)
+
+// GPTPartTypeLinuxRootForArch returns the Discoverable Partitions
+// Specification root GUID for goarch (a runtime.GOARCH value). Defaults to
+// the x86_64 GUID for any architecture other than arm64, matching this
+// installer's only other supported target.
+func GPTPartTypeLinuxRootForArch(goarch string) string {
+	if goarch == "arm64" {
+		return GPTPartTypeLinuxRootARM64
+	}
+	return GPTPartTypeLinuxRootX86_64
+}
 
 // GetProcMountsPath returns the current mounts file path. For testing only.
 func GetProcMountsPath() string { return procMountsPath }
