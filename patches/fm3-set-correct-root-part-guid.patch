+//
+// gptRootRetagPartition reports which partition number holds root and should
+// be retagged to the Discoverable Partitions Specification root GUID for GPT
+// auto-discovery on a composefs-native ("sealed") install, and whether it
+// should happen at all for this configuration. See the call site for the
+// full rationale (bootloader, LUKS, ZFS, and manual-layout considerations).
+func gptRootRetagPartition(isManual, isSystemdBoot bool, filesystem string, composeFsBackend bool) (partNum int, ok bool) {
+	if isManual || filesystem == "zfs" || !composeFsBackend {
+		return 0, false
+	}
+	if isSystemdBoot {
+		return 2, true // 2-partition layout: p1=EFI, p2=root
+	}
+	return 3, true // 3-partition layout: p1=EFI, p2=/boot, p3=root
+}
