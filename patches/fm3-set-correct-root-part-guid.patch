index 339b1b4..54b46fb 100644
--- a/fisherman/internal/disk/partition_test.go
+++ b/fisherman/internal/disk/partition_test.go
@@ -588,3 +588,28 @@ func containsArg(args []string, target string) bool {
 	}
 	return false
 }
+
+// TestGPTPartTypeLinuxRootForArch verifies the Discoverable Partitions
+// Specification root GUID is selected per architecture, not hardcoded to
+// x86_64 for every install (e.g. an arm64 target previously would have been
+// retagged with the wrong GUID, defeating GPT auto-discovery just the same
+// as not retagging at all).
+func TestGPTPartTypeLinuxRootForArch(t *testing.T) {
+	tests := []struct {
+		goarch string
+		want   string
+	}{
+		{"amd64", disk.GPTPartTypeLinuxRootX86_64},
+		{"arm64", disk.GPTPartTypeLinuxRootARM64},
+		{"", disk.GPTPartTypeLinuxRootX86_64},    // unknown/unset: x86_64 default
+		{"386", disk.GPTPartTypeLinuxRootX86_64}, // unsupported arch: x86_64 default, not a panic
+	}
+	for _, tt := range tests {
+		if got := disk.GPTPartTypeLinuxRootForArch(tt.goarch); got != tt.want {
+			t.Errorf("GPTPartTypeLinuxRootForArch(%q) = %q, want %q", tt.goarch, got, tt.want)
+		}
+	}
+	if disk.GPTPartTypeLinuxRootX86_64 == disk.GPTPartTypeLinuxRootARM64 {
+		t.Fatal("x86_64 and arm64 root GUIDs must differ")
+	}
+}
