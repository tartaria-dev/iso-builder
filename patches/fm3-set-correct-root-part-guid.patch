diff --git a/fisherman/cmd/fisherman/main_test.go b/fisherman/cmd/fisherman/main_test.go
index 7419b82..1c47484 100644
--- a/fisherman/cmd/fisherman/main_test.go
+++ b/fisherman/cmd/fisherman/main_test.go
@@ -233,3 +233,71 @@ func TestCheckRequiredTools_SystemdCryptenrollNotCheckedForPlainLUKS(t *testing.
 		t.Errorf("systemd-cryptenroll should not be checked for luks-passphrase, got: %v", err)
