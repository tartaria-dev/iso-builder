@@ -0,0 +1,79 @@
+package install
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestIsNoSuchPath(t *testing.T) {
+	for _, s := range []string{
+		"Error: copying from container: no such file or directory",
+		"Error: could not find /usr/lib/fisherman/efi in container",
+	} {
+		if !isNoSuchPath(s) {
+			t.Errorf("isNoSuchPath(%q) = false, want true", s)
+		}
+	}
+	if isNoSuchPath("Error: permission denied") {
+		t.Error("isNoSuchPath(permission denied) = true, want false")
+	}
+}
+
+func TestCopyTree_OverwritesAndSkipsSymlinks(t *testing.T) {
+	src, dst := t.TempDir(), t.TempDir()
+	write := func(root, rel, data string) {
+		p := filepath.Join(root, rel)
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(data), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(src, "EFI/BOOT/BOOTX64.EFI", "shim")
+	write(src, "EFI/BOOT/mmx64.efi", "mm")
+	write(dst, "EFI/BOOT/BOOTX64.EFI", "unsigned-sd-boot")
+	write(dst, "EFI/systemd/systemd-bootx64.efi", "keep")
+	if err := os.Symlink("/etc/passwd", filepath.Join(src, "EFI", "BOOT", "link.efi")); err != nil {
+		t.Fatal(err)
+	}
+
+	n, err := copyTree(src, dst)
+	if err != nil {
+		t.Fatalf("copyTree: %v", err)
+	}
+	if n != 2 {
+		t.Errorf("copied %d files, want 2", n)
+	}
+	got, _ := os.ReadFile(filepath.Join(dst, "EFI/BOOT/BOOTX64.EFI"))
+	if string(got) != "shim" {
+		t.Errorf("BOOTX64.EFI = %q, want overwritten with %q", got, "shim")
+	}
+	if _, err := os.Stat(filepath.Join(dst, "EFI/BOOT/link.efi")); err == nil {
+		t.Error("symlink was copied, want skipped")
+	}
+	if b, _ := os.ReadFile(filepath.Join(dst, "EFI/systemd/systemd-bootx64.efi")); string(b) != "keep" {
+		t.Error("unrelated ESP file was modified")
+	}
+}
+
+// With no payload files staged the function must succeed and touch nothing,
+// and it must always clean up the temporary container.
+func TestInstallEFIPayload_EmptyPayloadIsNoop(t *testing.T) {
+	mock := setupInstallMockExec(t)
+	target := t.TempDir()
+
+	if err := InstallEFIPayload(target, "containers-storage:ghcr.io/x/y:latest"); err != nil {
+		t.Fatalf("InstallEFIPayload: %v", err)
+	}
+	if len(mock.calls) != 3 {
+		t.Fatalf("expected create, cp, rm; got %v", mock.calls)
+	}
+	if mock.calls[0].args[0] != "create" || mock.calls[0].args[3] != "ghcr.io/x/y:latest" {
+		t.Errorf("create args = %v (transport prefix should be stripped)", mock.calls[0].args)
+	}
+	if mock.calls[1].args[0] != "cp" || mock.calls[2].args[0] != "rm" {
+		t.Errorf("unexpected call order: %v", mock.calls)
+	}
+}
