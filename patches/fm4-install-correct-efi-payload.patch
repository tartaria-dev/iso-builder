diff --git a/fisherman/internal/install/efipayload.go b/fisherman/internal/install/efipayload.go
new file mode 100644
index 0000000..7a19812
--- /dev/null
+++ b/fisherman/internal/install/efipayload.go
@@ -0,0 +1,106 @@
+package install
+
+import (
+	"bytes"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/tuna-os/fisherman/internal/progress"
+)
+
+// efiPayloadDir is where an image can ship an overlay for the ESP. The
+// directory mirrors the ESP layout, e.g.
+//
+//	/usr/lib/fisherman/efi/EFI/BOOT/BOOTX64.EFI   (shim)
+//	/usr/lib/fisherman/efi/EFI/BOOT/mmx64.efi
+//	/usr/lib/fisherman/efi/EFI/BOOT/grubx64.efi   (signed systemd-boot)
+//
+// Images that need a Secure Boot chain other than "signed systemd-boot
+// verified directly by firmware" (for example shim + MOK) use this so the
+// bootloader files bootctl wrote are replaced with the image's own.
+const efiPayloadDir = "/usr/lib/fisherman/efi"
+
+// InstallEFIPayload copies the image's ESP overlay (efiPayloadDir) onto the
+// target ESP, overwriting files bootctl or InstallSystemdBoot put there. It is
+// a no-op when the image ships no payload.
+func InstallEFIPayload(targetMount, imageRef string) error {
+	efiDir := filepath.Join(targetMount, "boot", "efi")
+
+	stage, err := os.MkdirTemp("", "fisherman-efi-")
+	if err != nil {
+		return fmt.Errorf("creating staging dir: %w", err)
+	}
+	defer os.RemoveAll(stage)
+
+	name := fmt.Sprintf("fisherman-efi-%d", os.Getpid())
+	if err := Exec.Command("podman", "create", "--name", name, bareImageRef(imageRef)).Run(); err != nil {
+		return fmt.Errorf("podman create %s: %w", imageRef, err)
+	}
+	defer func() { _ = Exec.Command("podman", "rm", "-f", name).Run() }()
+
+	var stderr bytes.Buffer
+	cp := Exec.Command("podman", "cp", name+":"+efiPayloadDir+"/.", stage)
+	cp.SetStderr(&stderr)
+	if err := cp.Run(); err != nil {
+		if isNoSuchPath(stderr.String()) {
+			progress.Info("image ships no EFI payload, leaving ESP as installed")
+			return nil
+		}
+		return fmt.Errorf("podman cp %s: %w: %s", efiPayloadDir, err, strings.TrimSpace(stderr.String()))
+	}
+
+	n, err := copyTree(stage, efiDir)
+	if err != nil {
+		return err
+	}
+	if n == 0 {
+		progress.Info("EFI payload directory is empty, leaving ESP as installed")
+		return nil
+	}
+	progress.Info(fmt.Sprintf("Installed %d EFI payload file(s) from the image onto the ESP", n))
+	return nil
+}
+
+// isNoSuchPath reports whether podman cp's stderr says the source path is
+// absent from the container (as opposed to a real failure).
+func isNoSuchPath(stderr string) bool {
+	s := strings.ToLower(stderr)
+	return strings.Contains(s, "no such file") || strings.Contains(s, "could not find")
+}
+
+// copyTree copies regular files from src onto dst, creating directories and
+// overwriting existing files. Symlinks and other special files are skipped.
+// It returns the number of files copied.
+func copyTree(src, dst string) (int, error) {
+	count := 0
+	err := filepath.WalkDir(src, func(path string, d fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		rel, err := filepath.Rel(src, path)
+		if err != nil {
+			return err
+		}
+		if rel == "." {
+			return nil
+		}
+		target := filepath.Join(dst, rel)
+		switch {
+		case d.IsDir():
+			return os.MkdirAll(target, 0o755)
+		case d.Type().IsRegular():
+			if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
+				return err
+			}
+			if err := copyFile(path, target); err != nil {
+				return fmt.Errorf("copying %s: %w", rel, err)
+			}
+			count++
+		}
+		return nil
+	})
+	return count, err
+}
