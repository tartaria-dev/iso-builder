diff --git a/fisherman/internal/install/efipayload.go b/fisherman/internal/install/efipayload.go
new file mode 100644
index 0000000..9c687d9
--- /dev/null
+++ b/fisherman/internal/install/efipayload.go
@@ -0,0 +1,120 @@
+package install
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/tuna-os/fisherman/internal/progress"
+)
+
+// efiSrcDir is where an image that ships its own Secure Boot chain (shim +
+// signed bootloader) keeps the files; they are copied to EFI/BOOT on the ESP.
+const efiSrcDir = "/boot/EFI/BOOT"
+
+// Files copied from efiSrcDir. If the image has no BOOTX64.EFI the whole step
+// is skipped. If it does, every required file must be present, so the ESP is
+// never left with half a chain.
+var (
+	efiRequired = []string{"BOOTX64.EFI", "grubx64.efi", "mmx64.efi"}
+	efiOptional = []string{"shimx64.efi", "fbx64.efi"}
+)
+
+// InstallEFIPayload copies the image's shim chain from /boot/EFI/BOOT onto the
+// target ESP, overwriting the unsigned systemd-boot that bootctl or
+// InstallSystemdBoot put at EFI/BOOT/BOOTX64.EFI. No-op if the image ships none.
+func InstallEFIPayload(targetMount, imageRef string) error {
+	efiBoot := filepath.Join(targetMount, "boot", "efi", "EFI", "BOOT")
+
+	stage, err := os.MkdirTemp("", "fisherman-efi-")
+	if err != nil {
+		return fmt.Errorf("creating staging dir: %w", err)
+	}
+	defer os.RemoveAll(stage)
+
+	name := fmt.Sprintf("fisherman-efi-%d", os.Getpid())
+	if err := Exec.Command("podman", "create", "--name", name, bareImageRef(imageRef)).Run(); err != nil {
+		return fmt.Errorf("podman create %s: %w", imageRef, err)
+	}
+	defer func() { _ = Exec.Command("podman", "rm", "-f", name).Run() }()
+
+	// Probe with BOOTX64.EFI: absent means this image has no shim chain.
+	if err := stageEFIFile(name, stage, "BOOTX64.EFI"); err != nil {
+		if isNoSuchPath(err.Error()) {
+			progress.Info("image ships no " + efiSrcDir + "/BOOTX64.EFI, leaving ESP as installed")
+			return nil
+		}
+		return err
+	}
+	if _, err := os.Stat(filepath.Join(stage, "BOOTX64.EFI")); err != nil {
+		progress.Info("image ships no " + efiSrcDir + "/BOOTX64.EFI, leaving ESP as installed")
+		return nil
+	}
+
+	for _, f := range efiRequired[1:] {
+		if err := stageEFIFile(name, stage, f); err != nil {
+			return fmt.Errorf("image has BOOTX64.EFI but is missing required %s: %w", f, err)
+		}
+	}
+	for _, f := range efiOptional {
+		if err := stageEFIFile(name, stage, f); err != nil {
+			if !isNoSuchPath(err.Error()) {
+				return err
+			}
+			progress.Info("optional " + f + " not in image, skipping")
+		}
+	}
+
+	n, err := installEFIFiles(stage, efiBoot)
+	if err != nil {
+		return err
+	}
+	progress.Info(fmt.Sprintf("Installed %d EFI file(s) from the image into the ESP's EFI/BOOT", n))
+	return nil
+}
+
+// stageEFIFile copies one file out of the container into stage.
+func stageEFIFile(container, stage, file string) error {
+	var stderr bytes.Buffer
+	cp := Exec.Command("podman", "cp", container+":"+efiSrcDir+"/"+file, filepath.Join(stage, file))
+	cp.SetStderr(&stderr)
+	if err := cp.Run(); err != nil {
+		return fmt.Errorf("podman cp %s/%s: %w: %s", efiSrcDir, file, err, strings.TrimSpace(stderr.String()))
+	}
+	return nil
+}
+
+// installEFIFiles copies the staged files onto dst (EFI/BOOT on the ESP),
+// overwriting existing ones. It fails before writing anything if a required
+// file is missing from stage. Returns the number of files copied.
+func installEFIFiles(stage, dst string) (int, error) {
+	for _, f := range efiRequired {
+		if _, err := os.Stat(filepath.Join(stage, f)); err != nil {
+			return 0, fmt.Errorf("required EFI file %s not staged: %w", f, err)
+		}
+	}
+	if err := os.MkdirAll(dst, 0o755); err != nil {
+		return 0, err
+	}
+	n := 0
+	for _, f := range append(append([]string{}, efiRequired...), efiOptional...) {
+		src := filepath.Join(stage, f)
+		if _, err := os.Stat(src); err != nil {
+			continue // optional file not present
+		}
+		if err := copyFile(src, filepath.Join(dst, f)); err != nil {
+			return n, fmt.Errorf("copying %s: %w", f, err)
+		}
+		n++
+	}
+	return n, nil
+}
+
+// isNoSuchPath reports whether podman cp's error text says the source path is
+// absent from the container (as opposed to a real failure).
+func isNoSuchPath(s string) bool {
+	s = strings.ToLower(s)
+	return strings.Contains(s, "no such file") || strings.Contains(s, "could not find")
+}
diff --git a/fisherman/internal/install/efipayload_test.go b/fisherman/internal/install/efipayload_test.go
new file mode 100644
index 0000000..d9a142c
--- /dev/null
+++ b/fisherman/internal/install/efipayload_test.go
@@ -0,0 +1,92 @@
+package install
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeFile(t *testing.T, root, rel, data string) {
+	t.Helper()
+	p := filepath.Join(root, rel)
+	if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(data), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestIsNoSuchPath(t *testing.T) {
+	if !isNoSuchPath("Error: no such file or directory") || !isNoSuchPath("could not find /x") {
+		t.Error("isNoSuchPath missed a not-found message")
+	}
+	if isNoSuchPath("Error: permission denied") {
+		t.Error("isNoSuchPath matched an unrelated error")
+	}
+}
+
+func TestInstallEFIFiles_OverwritesAndCopiesOptional(t *testing.T) {
+	stage, dst := t.TempDir(), t.TempDir()
+	for _, f := range []string{"BOOTX64.EFI", "grubx64.efi", "mmx64.efi", "fbx64.efi"} {
+		writeFile(t, stage, f, "new-"+f)
+	}
+	writeFile(t, dst, "BOOTX64.EFI", "unsigned-sd-boot")
+	writeFile(t, dst, "other.efi", "keep")
+
+	n, err := installEFIFiles(stage, dst)
+	if err != nil {
+		t.Fatalf("installEFIFiles: %v", err)
+	}
+	if n != 4 {
+		t.Errorf("copied %d files, want 4 (3 required + fbx64)", n)
+	}
+	if b, _ := os.ReadFile(filepath.Join(dst, "BOOTX64.EFI")); string(b) != "new-BOOTX64.EFI" {
+		t.Errorf("BOOTX64.EFI = %q, want overwritten", b)
+	}
+	if b, _ := os.ReadFile(filepath.Join(dst, "other.efi")); string(b) != "keep" {
+		t.Error("unrelated file was modified")
+	}
+	if _, err := os.Stat(filepath.Join(dst, "shimx64.efi")); err == nil {
+		t.Error("absent optional file appeared on the ESP")
+	}
+}
+
+// A missing required file must fail before anything is written, so the ESP is
+// never left with a broken chain.
+func TestInstallEFIFiles_MissingRequiredWritesNothing(t *testing.T) {
+	stage, dst := t.TempDir(), t.TempDir()
+	writeFile(t, stage, "BOOTX64.EFI", "shim")
+	writeFile(t, stage, "mmx64.efi", "mm") // grubx64.efi missing
+	writeFile(t, dst, "BOOTX64.EFI", "unsigned-sd-boot")
+
+	if _, err := installEFIFiles(stage, dst); err == nil {
+		t.Fatal("expected error for missing grubx64.efi")
+	}
+	if b, _ := os.ReadFile(filepath.Join(dst, "BOOTX64.EFI")); string(b) != "unsigned-sd-boot" {
+		t.Error("ESP was modified despite the failure")
+	}
+}
+
+// With the mock executor nothing is staged, so BOOTX64.EFI never appears and
+// the step must be a no-op that still removes the temporary container.
+func TestInstallEFIPayload_NoShimInImageIsNoop(t *testing.T) {
+	mock := setupInstallMockExec(t)
+	target := t.TempDir()
+
+	if err := InstallEFIPayload(target, "containers-storage:ghcr.io/x/y:latest"); err != nil {
+		t.Fatalf("InstallEFIPayload: %v", err)
+	}
+	if len(mock.calls) != 3 {
+		t.Fatalf("expected create, cp (probe), rm; got %v", mock.calls)
+	}
+	if mock.calls[0].args[0] != "create" || mock.calls[0].args[3] != "ghcr.io/x/y:latest" {
+		t.Errorf("create args = %v", mock.calls[0].args)
+	}
+	if mock.calls[1].args[0] != "cp" || mock.calls[2].args[0] != "rm" {
+		t.Errorf("unexpected call order: %v", mock.calls)
+	}
+	if _, err := os.Stat(filepath.Join(target, "boot")); err == nil {
+		t.Error("ESP path was created for an image with no shim")
+	}
+}
