-// TestBootcViaContainer_MountsSys is a regression test for projectbluefin/fisherman PR #2.
+// TestComposeFsVarTmpIsDiskBacked is a regression test for the ENOSPC bug
+// observed on a real composefs install: podman's own image-copy machinery
+// (importing the oci: source into its overlay-based --root storage, before
+// bootc install even starts inside the container) stages blobs through
+// /var/tmp regardless of the separately bind-mounted oci-cache. With
+// --tmpfs /var/tmp (RAM-backed), this failed partway through a
+// multi-gigabyte image with "no space left on device". /var/tmp must be
+// disk-backed, and — per Issue #38 — must not be the scratch root itself
+// (which would nest oci-cache under it again).
+func TestComposeFsVarTmpIsDiskBacked(t *testing.T) {
+	tmpDir := t.TempDir()
+
+	install.SkopeoExportOCIFn = func(image, destDir, tmpdir string) error {
+		return os.MkdirAll(destDir, 0755)
+	}
+	t.Cleanup(func() { install.SkopeoExportOCIFn = install.DefaultSkopeoExportOCI })
+
+	scratchDir := filepath.Join(tmpDir, "scratch")
+	if err := os.MkdirAll(scratchDir, 0755); err != nil {
+		t.Fatalf("mkdir scratch: %v", err)
+	}
+	target := filepath.Join(tmpDir, "target")
+	if err := os.MkdirAll(target, 0755); err != nil {
+		t.Fatalf("mkdir target: %v", err)
+	}
+
+	oldStdout := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("os.Pipe: %v", err)
+	}
+	os.Stdout = w
+
+	_ = install.BootcInstall(install.Options{
+		ComposeFsBackend: true,
+		SourceImgref:     "containers-storage:ghcr.io/example/os:latest",
+		TargetImgref:     "ghcr.io/example/os:latest",
+		Target:           target,
+		ScratchDir:       scratchDir,
+		NeedsPull:        false,
+	})
+
+	w.Close()
+	os.Stdout = oldStdout
+	var buf bytes.Buffer
+	io.Copy(&buf, r) //nolint:errcheck
+	output := buf.String()
+
+	// Must NOT use tmpfs for /var/tmp on a composefs install.
+	if strings.Contains(output, "--tmpfs /var/tmp") {
+		t.Errorf("composefs install still uses RAM-backed --tmpfs /var/tmp "+
+			"(will ENOSPC on large images)\ngot: %s", output)
+	}
+
+	// Must mount a disk-backed directory at /var/tmp, and it must be a
+	// dedicated subdirectory of scratch — not the scratch root itself
+	// (which would reintroduce issue #38's oci-cache nesting).
+	wantVarTmp := filepath.Join(scratchDir, "var-tmp") + ":/var/tmp:z"
+	if !strings.Contains(output, wantVarTmp) {
+		t.Errorf("composefs install missing disk-backed /var/tmp mount %q\ngot: %s",
+			wantVarTmp, output)
+	}
+}
