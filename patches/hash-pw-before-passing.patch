 logger = logging.getLogger("Installer::Processor")
 
 
+def _hash_user_password(password: str) -> str:
+    """Hash a plaintext user password into a crypt(3) string ("$6$salt$hash")
+    fisherman can write verbatim via `chpasswd -e`.
+
+    Passing plaintext straight through to fisherman forces it to hash the
+    password itself via `chpasswd` without -e, which invokes the target's PAM
+    stack (pam_chauthtok) to do so. On a composefs-native deploy fisherman
+    only has `chpasswd --root <dir>`, not a real chroot(2), so PAM's module
+    resolution doesn't line up with the target and the whole install aborts —
+    "pam_chauthtok() failed, error: Module is unknown" on some images,
+    "exit status 1" on others (EL10). Hashing here means fisherman never
+    invokes PAM to set the password at all, regardless of target quirks.
+
+    Already-hashed input (anything starting with "$", e.g. supplied via a
+    companion/mobile setup config) is returned unchanged — re-hashing a hash
+    would just make the literal hash text the real password.
+
+    Empty input is returned unchanged: CreateUser treats an empty password as
+    "leave the account unset", not "set an empty password".
+    """
+    if not password or password.startswith("$"):
+        return password
+
+    try:
+        import crypt  # stdlib, deprecated since 3.11, removed in 3.13.
+        return crypt.crypt(password, crypt.mksalt(crypt.METHOD_SHA512))
+    except ImportError:
+        pass
+
+    # crypt module unavailable (Python >= 3.13): fall back to openssl, which
+    # is present on essentially every Linux host/runtime this app ships on.
+    try:
+        result = subprocess.run(
+            ["openssl", "passwd", "-6", "-stdin"],
+            input=password, capture_output=True, text=True, check=True,
+        )
+        return result.stdout.strip()
+    except (OSError, subprocess.CalledProcessError) as e:
+        # Hashing failed entirely: surface the plaintext rather than silently
+        # producing an unusable/empty recipe field. fisherman will fall back
+        # to its own PAM-based chpasswd path (the behavior before this fix),
+        # which is at least what happened previously, not a new failure mode.
+        logger.warning("Could not hash user password (%s); passing through unhashed", e)
+        return password
+
+
