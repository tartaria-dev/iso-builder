+// TestHostVarTmpBound_FalseBeforeBind covers the idempotence probe that stops a
+// nested overrideVarTmp from stacking a second bind mount over /var/tmp: a
+// fresh override dir on another filesystem is not an alias of /var/tmp.
+func TestHostVarTmpBound_FalseBeforeBind(t *testing.T) {
+	override := filepath.Join(t.TempDir(), "var-tmp-override")
+	if err := os.MkdirAll(override, 0o1777); err != nil {
+		t.Fatal(err)
+	}
+	if hostVarTmpBound(override) {
+		t.Error("hostVarTmpBound reported true before any bind mount")
+	}
+	if hostVarTmpBound(filepath.Join(override, "does-not-exist")) {
+		t.Error("hostVarTmpBound must be false when the override dir is missing")
+	}
+}
