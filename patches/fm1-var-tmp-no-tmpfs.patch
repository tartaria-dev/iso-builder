+// assertDiskBackedTmp checks the podman command line gives the container a
+// disk-backed /var/tmp and /tmp plus TMPDIR, and no tmpfs for either.
+func assertDiskBackedTmp(t *testing.T, label, output, scratchDir string) {
+	t.Helper()
+	for _, want := range []string{scratchDir + ":/var/tmp", scratchDir + ":/tmp", "-e TMPDIR=/var/tmp"} {
+		if !strings.Contains(output, want) {
+			t.Errorf("%s: podman command missing %q\ngot: %s", label, want, output)
+		}
 	}
+	for _, bad := range []string{"--tmpfs /var/tmp", "--tmpfs /tmp"} {
+		if strings.Contains(output, bad) {
+			t.Errorf("%s: podman command still uses %q (ENOSPC on multi-GiB images)\ngot: %s", label, bad, output)
+		}
+	}
+}
