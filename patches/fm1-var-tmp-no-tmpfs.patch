+// scratchTmpArgs returns the podman args that make the container's /var/tmp and
+// /tmp disk-backed (bind of the scratch dir) and point TMPDIR at /var/tmp.
+func scratchTmpArgs(scratch string) []string {
+	return []string{
+		"-v", scratch + ":/var/tmp:z",
+		"-v", scratch + ":/tmp:z",
+		"-e", "TMPDIR=/var/tmp",
+	}
+}
+
+// hostVarTmpBound reports whether /var/tmp is currently a bind mount of
+// override. A bind mount of a directory presents the source's device and
+// inode, so os.SameFile on the two stats is the idempotence check.
+func hostVarTmpBound(override string) bool {
+	vt, err1 := os.Stat("/var/tmp")
+	ov, err2 := os.Stat(override)
+	if err1 != nil || err2 != nil {
+		return false
+	}
+	return os.SameFile(vt, ov)
+}
